<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Multitask</AssemblyName>
    <RootNamespace>Multitask</RootNamespace>
    <Version>0.7.0</Version>
    <Product>Melvor Idle 2 Multitask</Product>
    <AssemblyTitle>Multitask</AssemblyTitle>
    <Description>Keeps your recent actions running together (up to all of them) in Melvor Idle 2 (requires Melvor Mod Loader). Opens with F5.</Description>
    <Company>Melvor Mod Loader</Company>
    <Copyright>Copyright (c) 2026 falorfrozen. See LICENSE.</Copyright>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameData>..\..\..\data_GamesByMalcs.Melvor2_windows_x86_64</GameData>
    <LoaderDir>..\..\..\data_MelvorModLoader_windows_x86_64</LoaderDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same window look as the Cheat Menu, and the same per-skill start code as the Action Queue. -->
    <Compile Include="..\CheatMenu\Style.cs" Link="Style.cs" />
    <Compile Include="..\ActionQueue\Targets.cs" Link="Targets.cs" />
    <Compile Include="..\Shared\WindowKey.cs" Link="WindowKey.cs" />
    <Reference Include="MelvorModLoader"><HintPath>$(LoaderDir)\MelvorModLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GamesByMalcs.Melvor2"><HintPath>$(GameData)\GamesByMalcs.Melvor2.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
